\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background: var(--bg);\r\n  overflow: hidden;\r\n}\r\n.dashboard-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 24px;\r\n  height: 56px;\r\n  background: var(--surface);\r\n  border-bottom: 1px solid var(--border);\r\n  flex-shrink: 0;\r\n}\r\n.dashboard-header h1 {\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  letter-spacing: -0.01em;\r\n}\r\n.dashboard-layout {\r\n  display: grid;\r\n  grid-template-columns: 1fr 340px;\r\n  gap: 16px;\r\n  padding: 16px;\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n.webcam-container {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-xl);\r\n  box-shadow: var(--shadow);\r\n  padding: 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n}\r\n.webcam-wrapper {\r\n  position: relative;\r\n  flex: 1;\r\n  min-height: 0;\r\n  border-radius: var(--radius-lg);\r\n  overflow: hidden;\r\n  background: #0d1117;\r\n}\r\n.webcam-feed {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n  display: block;\r\n}\r\n.detection-overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: flex-end;\r\n  padding: 12px;\r\n  pointer-events: none;\r\n}\r\n.detection-alert {\r\n  padding: 6px 14px;\r\n  border-radius: 20px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  background: var(--red-bg);\r\n  color: var(--red);\r\n  border: 1px solid var(--red-border);\r\n}\r\n.system-decision {\r\n  padding: 12px 14px;\r\n  border-radius: var(--radius);\r\n  font-size: 13px;\r\n  flex-shrink: 0;\r\n  border: 1px solid var(--border);\r\n  background: var(--surface2);\r\n}\r\n.system-decision h3 {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  margin-bottom: 6