\r\n  background: var(--green);\r\n  animation: pulse 2s infinite;\r\n}\r\n@keyframes pulse {\r\n  0%,\r\n  100% {\r\n    opacity: 1;\r\n  }\r\n  50% {\r\n    opacity: 0.4;\r\n  }\r\n}\r\n/* countdown badge */\r\n.countdown-badge {\r\n  min-width: 52px;\r\n  padding: 7px 10px;\r\n  border-radius: 60px;\r\n  text-align: center;\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n  color: var(--amber);\r\n  background: var(--amber-bg);\r\n  border: 1px solid var(--amber-border);\r\n  font-family: \"DM Mono\", monospace;\r\n  flex-shrink: 0;\r\n}\r\n/* ─── RESULT CARD ───────────────────────────────────────────── */\r\n.result-card--operator {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n}\r\n.result-card__status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 12px;\r\n  border-radius: 20px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  background: var(--blue-bg);\r\n  color: var(--blue);\r\n  border: 1px solid var(--blue-border);\r\n  width: fit-content;\r\n}\r\n.result-card dl {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 8px;\r\n}\r\n.result-card dl > div {\r\n  background: var(--surface2);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 10px 14px;\r\n}\r\n.result-card dt {\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  color: var(--text3);\r\n  margin-bottom: 2px;\r\n}\r\n.result-card dd {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  font-family: \"DM Mono\", monospace;\r\n}\r\n/* ─── DETECTION LIST ────────────────────────────────────────── */\r\n.detection-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n.detection-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 11px 14px;\r\n  border-radius: 12px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  transition: all 0.2s;\r\n