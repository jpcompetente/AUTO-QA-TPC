# Frontend Environment Configuration
# Copy this file to .env.local and update the values for your environment

# Development (uses Vite proxy: /api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=/api

# Production - uncomment and update for your deployment:
# VITE_API_BASE_URL=https://10.0.2.132:8000
# VITE_API_BASE_URL=https://your-production-domain.com:8000

# WebSocket endpoint (if different from HTTP API)
VITE_WS_URL=ws://127.0.0.1:8000

# Optional: Set to true if backend uses self-signed certificates
VITE_INSECURE_SSL=false
